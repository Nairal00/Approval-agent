{
  "name": "ropa-review-agent",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {}
  },

  "postCreateCommand": "npm install -g @anthropic-ai/claude-code && if [ -f requirements.txt ]; then python -m pip install --user -r requirements.txt; fi",

  "workspaceMount": "source=${localWorkspaceFolder},target=/work,type=bind",
  "workspaceFolder": "/work",

  "mounts": [
    "source=claude-home,target=/home/vscode,type=volume"
  ],

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.pylint"]
    }
  }
}
