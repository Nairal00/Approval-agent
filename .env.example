# Copy the lines below into your shell (or a .env file you load yourself).
# Never commit real keys. .env is listed in .gitignore.

# DeepSeek's Anthropic-compatible endpoint
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=your-deepseek-api-key

# Claude model alias passed to the agent. DeepSeek maps claude-sonnet-* to
# deepseek-flash when using its Anthropic-compatible endpoint.
ROPA_MODEL=claude-sonnet-4-5
